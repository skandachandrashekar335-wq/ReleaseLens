# ReleaseLens Environment Configuration Template
# Copy to .env for local development

NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db

# Optional GitHub Integration
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# Worker Execution Driver: local_process | docker | cloud_sandbox
WORKER_ISOLATION_DRIVER=local_process

# Optional AI Audience Synthesis Provider Key
LLM_API_KEY=
