# ReleaseLens Environment Configuration Template
# Copy to .env.local for local development or set in Vercel project settings

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Provider: sqlite (local development) | supabase (production PostgreSQL)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# Production Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# Firebase Authentication Configuration (Client SDK)
# Required for client-side Google Sign-In popup & token retrieval
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef...

# -----------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side Only)
# Never expose these keys to the client or browser bundles
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key should include newline characters or standard PEM format
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Worker Isolation & Engine Settings
# -----------------------------------------------------------------------------
# Worker Execution Driver: local_process | docker | cloud_sandbox
WORKER_ISOLATION_DRIVER=local_process

# Optional AI Assistant / LLM Provider Key
LLM_API_KEY=
